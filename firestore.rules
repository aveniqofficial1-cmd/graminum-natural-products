rules_version = '2';

// Shared store data. The Spark plan cannot host the trusted writer function,
// and staff sign in through the app's own local login rather than Firebase
// Auth, so the browser reads and writes these three collections directly.
// Every other collection is denied. The admin security password is never
// stored here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'orderNumber', 'customerEmail', 'orderStatus'])
        && request.resource.data.id == orderId;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'price'])
        && request.resource.data.id == productId;
      allow delete: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update: if docId == 'store'
        && !request.resource.data.keys().hasAny(['adminSecurityPassword']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
